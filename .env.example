# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать можно у @userinfobot), можно несколько через запятую
ADMIN_IDS=

# ИИ-консультант (необязательно, любой OpenAI-совместимый сервис).
# Если пусто — бот подбирает товары по словам из запроса.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Mini App (веб-магазин)
WEBAPP_ENABLED=1
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Публичный HTTPS-адрес приложения (cloudflared/ngrok/хостинг) —
# без него кнопка Mini App внутри Telegram не появится
WEBAPP_URL=
# Доступ без Telegram-подписи по заголовку X-Dev-Id (только localhost).
# Включай 1 только для локальной разработки
WEBAPP_DEV_MODE=0

# База данных (по умолчанию SQLite в корне проекта; поддерживается только SQLite)
# DB_URL=sqlite+aiosqlite:///nebula.db

# Сколько звёзд списывать за 1 ₽ (1 = один к одному, 1.5 = наценка 50%)
# STARS_RATE=1
